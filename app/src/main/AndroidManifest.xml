<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions - Only declare once at the top -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Camera and Storage Permissions for Profile Photo -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackMyBus"
        tools:targetApi="31">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_API_KEY_HERE" />

        <!-- FileProvider for Profile Photo Camera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ========================================== -->
        <!-- ONBOARDING ACTIVITIES -->
        <!-- ========================================== -->

        <!-- Splash Activity - MAIN LAUNCHER (Only one LAUNCHER!) -->
        <activity
            android:name=".ui.onboarding.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tutorial Activity -->
        <activity
            android:name=".ui.onboarding.TutorialActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar" />

        <!-- ========================================== -->
        <!-- AUTHENTICATION ACTIVITIES -->
        <!-- ========================================== -->

        <!-- Login Activity (NO launcher intent-filter!) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus" />

        <!-- Sign Up Activity -->
        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <!-- ========================================== -->
        <!-- PARENT ACTIVITIES -->
        <!-- ========================================== -->

        <!-- Parent Dashboard -->
        <activity
            android:name=".ui.parent.ParentDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar" />

        <!-- My Bus Activity -->
        <activity
            android:name=".ui.parent.MyBusActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar"
            android:parentActivityName=".ui.parent.ParentDashboardActivity" />

        <!-- Notifications Activity -->
        <activity
            android:name=".ui.parent.NotificationsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar"
            android:parentActivityName=".ui.parent.ParentDashboardActivity" />

        <!-- User Profile Activity -->
        <activity
            android:name=".ui.parent.UserProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar"
            android:parentActivityName=".ui.parent.ParentDashboardActivity" />

        <!-- Edit Profile Activity -->
        <activity
            android:name=".ui.parent.EditProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar"
            android:parentActivityName=".ui.parent.UserProfileActivity" />

        <!-- Map Activity -->
        <activity
            android:name=".ui.parent.MapActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar" />

        <!-- ========================================== -->
        <!-- DRIVER ACTIVITIES -->
        <!-- ========================================== -->

        <!-- Driver Dashboard -->
        <activity
            android:name=".ui.driver.DriverDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar" />

        <!-- ========================================== -->
        <!-- ADMIN ACTIVITIES -->
        <!-- ========================================== -->

        <!-- Admin Dashboard -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus" />

        <!-- Manage Drivers Activity -->
        <activity
            android:name=".ui.admin.ManageDriversActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus"
            android:parentActivityName=".ui.admin.AdminDashboardActivity" />

        <!-- Add Driver Activity -->
        <activity
            android:name=".ui.admin.AddDriverActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus"
            android:parentActivityName=".ui.admin.ManageDriversActivity" />

        <!-- Edit Driver Activity -->
        <activity
            android:name=".ui.admin.EditDriverActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus"
            android:parentActivityName=".ui.admin.ManageDriversActivity" />

        <!-- Add Admin/Driver Activity -->
        <activity
            android:name=".ui.admin.AddAdminDriverActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus"
            android:parentActivityName=".ui.admin.AdminDashboardActivity" />

        <!-- ========================================== -->
        <!-- OTHER ACTIVITIES -->
        <!-- ========================================== -->

        <!-- Main Activity (Legacy - can be removed later) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TrackMyBus" />

        <!-- Test Activity (Optional - for testing only) -->
        <activity
            android:name=".ui.test.TestFirebaseActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus" />

        <!-- About Activity -->
        <activity
            android:name=".ui.parent.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrackMyBus.NoActionBar"
            android:parentActivityName=".ui.parent.ParentDashboardActivity" />

    </application>

</manifest>