<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Blue Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/primary_blue"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Track My Bus"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="8dp"
                    android:text="Negombo Road, Wattala"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </RelativeLayout>

            <!-- No Bus Selected Layout -->
            <LinearLayout
                android:id="@+id/layoutNoBus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@android:drawable/ic_menu_directions"
                    android:tint="@color/text_gray"
                    android:alpha="0.5"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Bus Selected"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select your child's bus to track"
                    android:textSize="14sp"
                    android:textColor="@color/text_gray"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnSelectBus"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="Select Bus"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/primary_blue"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp" />
            </LinearLayout>

            <!-- Bus Details Layout -->
            <LinearLayout
                android:id="@+id/layoutBusDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <!-- Driver Card with Blue Background -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginTop="-40dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/primary_blue"
                        android:padding="24dp"
                        android:gravity="center">

                        <!-- Driver Profile -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:cardCornerRadius="50dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:id="@+id/ivDriverProfile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@android:drawable/ic_menu_myplaces"
                                android:scaleType="centerCrop" />
                        </androidx.cardview.widget.CardView>

                        <!-- Bus Number -->
                        <TextView
                            android:id="@+id/tvBusNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WP NA - 8965"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />

                        <!-- Driver Name -->
                        <TextView
                            android:id="@+id/tvDriverName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mr. Surendra Rajapaksha"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="8dp" />

                        <!-- Stars - THIS IS THE NEW ELEMENT -->
                        <TextView
                            android:id="@+id/tvStarRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐⭐⭐⭐⭐"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />

                        <!-- Route Visualization -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="24dp">

                            <!-- Line -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@android:color/white" />

                            <!-- Bus Icon in Center -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_centerInParent="true"
                                android:src="@android:drawable/ic_menu_directions"
                                android:tint="@android:color/white"
                                android:rotation="90" />

                            <!-- Start Point -->
                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_white_bg" />

                            <!-- End Point -->
                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_white_bg" />
                        </RelativeLayout>

                        <!-- From and To -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tvFromLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="Ja ela"
                                android:textSize="14sp"
                                android:textColor="@android:color/white"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvToLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Wycherley School"
                                android:textSize="14sp"
                                android:textColor="@android:color/white"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Rating Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rate This Driver"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <RatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="0"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/btnSubmitRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Submit"
                        android:textColor="@android:color/white"
                        android:backgroundTint="@color/primary_blue"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRatingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average: 4.5⭐ (120 ratings)"
                    android:textSize="14sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="24dp" />

                <!-- Contact Information -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Information"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="16dp" />

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/stat_sys_phone_call"
                        android:tint="@color/primary_blue" />

                    <TextView
                        android:id="@+id/tvPhoneNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+94 77 123 4567"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_email"
                        android:tint="@color/primary_blue" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="driver@example.com"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- Action Buttons -->
                <Button
                    android:id="@+id/btnTrackBus"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Track Bus Now"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary_blue"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnChangeBus"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Change Bus"
                    android:textColor="@color/primary_blue"
                    android:textSize="16sp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        app:menu="@menu/bottom_navigation_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>