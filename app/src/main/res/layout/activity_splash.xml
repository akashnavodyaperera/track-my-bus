<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_blue">

    <!-- Logo Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo Circle with White Background -->
        <androidx.cardview.widget.CardView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:elevation="8dp"
            app:cardCornerRadius="90dp"
            app:cardBackgroundColor="@android:color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bus_logo"
                android:contentDescription="Track My Bus Logo"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRACK MY BUS"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="32dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Journey, Happy Parents"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:alpha="0.9"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bottom Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="48dp">

        <!-- Progress Bar -->
        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- School Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wycherley International School"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:alpha="0.8" />

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:alpha="0.6"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</RelativeLayout>