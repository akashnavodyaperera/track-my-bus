<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Section: Profile, Info and Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Left Side: Profile and Info -->
            <LinearLayout
                android:id="@+id/leftSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Driver Profile Image -->
                <ImageView
                    android:id="@+id/ivDriverProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/circle_white_bg"
                    android:padding="4dp" />

                <!-- Driver Info -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvDriverName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mr. Surendra Rajapaksha"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />

                    <!-- Star Rating -->
                    <!-- Rating Display -->
                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐⭐⭐⭐⭐"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <!-- Rating Display -->
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right Side: Set as my bus Button -->
            <Button
                android:id="@+id/btnSetAsMyBus"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Set as my bus"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/primary_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false" />
        </RelativeLayout>

        <!-- Bus Number (Centered) -->
        <TextView
            android:id="@+id/tvBusNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="WP NA - 8965"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            android:layout_marginBottom="12dp" />

        <!-- Route Visualization -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <!-- Line connecting points -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/primary_blue" />

            <!-- Start Point (Blue Circle) -->
            <View
                android:id="@+id/viewStartPoint"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_blue_filled" />

            <!-- End Point (Blue Circle) -->
            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_blue_filled" />
        </RelativeLayout>

        <!-- From and To Labels -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From"
                    android:textSize="10sp"
                    android:textColor="@color/text_gray" />

                <TextView
                    android:id="@+id/tvFromLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Negombo"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To"
                    android:textSize="10sp"
                    android:textColor="@color/text_gray" />

                <TextView
                    android:id="@+id/tvToLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wycherley International School"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:maxWidth="180dp"
                    android:gravity="end" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>