<?xml version="1.0" encoding="utf-8"?>
<resources>    <!-- Base application theme (Merged into one definition) -->
    <!-- Note: I've kept Material3 as the parent since your build.gradle uses Compose and Material3 -->
    <style name="Theme.TrackMyBus" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/accent_orange</item>

        <!-- Compatibility items from your previous MaterialComponents definition -->
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
    </style>

    <!-- Theme for activities that need NoActionBar (Inherits from base) -->
    <style name="Theme.TrackMyBus.NoActionBar" parent="Theme.TrackMyBus">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Add fullscreen here if you want it specifically for Splash/Tutorial -->
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>